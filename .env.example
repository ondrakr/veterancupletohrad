# ===========================================
# Veterán Cup Letohrad – konfigurace
# ===========================================
# Zkopírujte do .env.local a vyplňte hodnoty.
# Na produkci použijte .env

# --- Databáze MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veterancup

# --- Web / doména ---
SITE_DOMAIN=veterancupletohrad.cz
SITE_URL=https://veterancupletohrad.cz

# --- Autentizace admin ---
JWT_SECRET=nahradte-nahodnym-retezcem-min-32-znaku
